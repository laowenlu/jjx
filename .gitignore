# Ignore .env and sensitive config files
/api/.env
/api/local.settings.json

# Ignore binaries and object files across projects
**/bin/
**/obj/

# Ignore IDE-specific files and settings
.vs/
*.DotSettings.user

# Ignore OS-generated files (macOS, Windows)
.DS_Store

# Ignore node_modules in case you're using Node.js
**/node_modules/

# Frontend build output
**/dist/

# Local configuration and secrets
**/.env
**/.env.*
!**/.env.example
